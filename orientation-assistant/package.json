{
	"name": "orientation-assistant",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test:pdf": "node --test tests/pdf.test.js",
		"extract": "node scripts/extract-pdf.js",
		"build:knowledge": "node scripts/build-knowledge.js",
		"correspondances": "node scripts/propose-correspondances.js",
		"test:knowledge": "node --test tests/knowledge.test.js",
		"test": "node --test",
		"test:rag": "node --test tests/rag.test.js",
		"chat": "node --env-file=.env scripts/essai-chat.js",
		"start": "node --env-file-if-exists=.env build"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"svelte": "^5.57.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"pdfjs-dist": "^6.5.438"
	}
}
